NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (server-side only - DO NOT expose to client)
# Get this from Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Payment — Pay with MTN MoMo or Airtel Money via RwandaPay (https://rwandapay.rw)
PAYMENT_PROVIDER=rwandapay

# RwandaPay — https://rwandapay.rw/docs (Base URL: https://pay.rwandapay.rw/api/v1)
# Keys from https://merchant.rwandapay.rw/settings — pk_live_* / sk_live_* (live) or pk_test_* / sk_test_* (sandbox)
RWANDA_PAY_BASE_URL=https://pay.rwandapay.rw/api/v1
RWANDA_PAY_PUBLIC_KEY=pk_live_XXXXXXXXXXXXXXXX
RWANDA_PAY_SECRET_KEY=sk_live_XXXXXXXXXXXXXXXX
# Webhook secret (Settings > Webhooks). Must match HMAC secret used to sign X-Webhook-Signature.
# Register: https://agezweho.com/api/payments/webhook  Events: transaction:processed, payment.successful, payment.failed
RWANDA_PAY_WEBHOOK_SECRET=whsec_XXXXXXXXXXXXXXXX
# API docs: https://rwandapay.rw/docs — Flows: Hosted Checkout POST /checkout/initialize + Collections POST /collections

# MTN MoMo API (legacy, not used — RwandaPay handles MTN + Airtel)
MTN_MOMO_API_KEY=
MTN_MOMO_API_SECRET=

# OMDB API Key (https://www.omdbapi.com/apikey.aspx)
OMDB_API_KEY=your-omdb-api-key-here

# Admin email for premium access approvals
ADMIN_EMAIL=macyenga@gmail.com

# Site URL (used for payment redirects)
NEXT_PUBLIC_SITE_URL=https://agezweho.com
