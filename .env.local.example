# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase Service Role Key (server-side only - DO NOT expose to client)
# Get this from Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payment Provider: 'mtn-momo' | 'rwandapay' | 'local'
PAYMENT_PROVIDER=local

# RwandaPay API (https://rwandapay.rw/docs)
RWANDAPAY_API_KEY=
RWANDAPAY_SECRET=
RWANDAPAY_BASE_URL=https://api.rwandapay.rw/v1

# MTN MoMo API (https://momoapi.mtn.co.rw)
MTN_MOMO_SUBSCRIPTION_KEY=
MTN_MOMO_API_USER=
MTN_MOMO_API_KEY=
MTN_MOMO_TARGET_ENV=production
MTN_MOMO_BASE_URL=https://momoapi.mtn.co.rw

# Public MoMo details (used by client components)
NEXT_PUBLIC_MOMO_NUMBER=0789690247
NEXT_PUBLIC_USSD_CODE=*182*8*1*156833#
NEXT_PUBLIC_CONTACT_EMAIL=macyenga@gmail.com

# Admin email for premium access approvals
ADMIN_EMAIL=admin@example.com

# Site URL (used for payment redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# MoMo payment details (used by local payment provider)
MOMO_NUMBER=0789690247
USSD_CODE=*182*8*1*156833#

# OMDB API Key (for movie search autocomplete on submit page)
# Get a free key at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=e09889cb

# Monthly donation goal (in RWF)
MONTHLY_DONATION_GOAL=100000

# Webhook shared secret for payment callbacks
WEBHOOK_SECRET=your-webhook-secret
