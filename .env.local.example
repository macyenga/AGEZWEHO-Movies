NEXT_PUBLIC_SUPABASE_URL=your-supabase-url-here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Service Role Key (server-side only - DO NOT expose to client)
# Get this from Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Payment Provider: 'flutterwave' | 'rwandapay' | 'mtn-momo' | 'local'
PAYMENT_PROVIDER=flutterwave

# Flutterwave Live Keys (https://dashboard.flutterwave.com)
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=your-flutterwave-public-key-here
FLUTTERWAVE_SECRET_KEY=your-flutterwave-secret-key-here
FLUTTERWAVE_SECRET_HASH=

# RwandaPay API (https://rwandapay.rw/docs)
RWANDAPAY_API_KEY=
RWANDAPAY_SECRET=

# MTN MoMo API (https://momoapi.mtn.co.rw)
MTN_MOMO_API_KEY=
MTN_MOMO_API_SECRET=

# Admin email for premium access approvals
ADMIN_EMAIL=macyenga@gmail.com

# Site URL (used for payment redirects)
NEXT_PUBLIC_SITE_URL=https://agezweho.com
